FAL_KEY=your-fal-ai-api-key
MELTFLEX_API_KEY=your-meltflex-api-key

# Local geometry-ai inference service (Phase 2 feasibility playground)
# GEOMETRY_AI_SERVICE_URL=http://127.0.0.1:8787
# GEOMETRY_AI_PORT=8787  # host port for the geometry-ai docker-compose service
# Input normalization for colour/photo floor plans (brown/tiled backgrounds):
# none | gray | binary  (binary is the default = Otsu -> dark lines on white)
# GEOMETRY_PREPROCESS=binary