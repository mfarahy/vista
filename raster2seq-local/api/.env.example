# Copy to .env and adjust. All paths may be relative to raster2seq-local/.
PORT=3000
CORS_ORIGIN=*

# Python executable used to run inference/infer_single.py
PYTHON_BIN=python

# Checkpoint for infer_single.py: local .pth path or hf:<alias>
# (hf:cubicasa5k | hf:s3d-bw | hf:raster2graph | hf:raster2graph-512 | hf:s3d-density)
CHECKPOINT=hf:cubicasa5k

# auto | cuda | cpu (auto uses CUDA when available; upstream needs CUDA)
DEVICE=auto

# Where uploaded images are staged briefly (deleted after each request)
TMP_DIR=

# Per-request inference budget in ms (model load + generation)
INFERENCE_TIMEOUT_MS=300000

# Upload guard in megabytes
MAX_IMAGE_MB=15

# Dev fallback without a GPU: return samples/mock-result.json instead of
# running the model. Keep "false" for real inference.
RASTER2SEQ_MOCK=false
