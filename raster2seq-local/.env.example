# Copy to .env and adjust. NEVER commit the real .env (it holds secrets).
#   Copy-Item .env.example .env   # then edit .env
#
# ── Cloudflare Tunnel (public HTTPS access) ─────────────────────────────────
# Create a tunnel in the Cloudflare dashboard (Zero Trust -> Networks ->
# Tunnels), copy its token here. Example hostname (configure it in the
# dashboard, pointing at http://raster2seq-api:3000):
#   R2S_PUBLIC_HOSTNAME=raster2seq.example.com
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
R2S_PUBLIC_HOSTNAME=raster2seq.example.com

# ── Local API ───────────────────────────────────────────────────────────────
# Host-side port for local dev (loopback only). Container port stays 3000.
RASTER2SEQ_PORT=3000
# Comma-separated origins, or * for fully public access (MVP default).
CORS_ORIGIN=*

# ── Inference ───────────────────────────────────────────────────────────────
# "true" = dev fallback (samples/mock-result.json, no GPU needed).
# "false" = real Raster2Seq (needs Linux + CUDA; see README).
RASTER2SEQ_MOCK=true
CHECKPOINT=hf:cubicasa5k
# auto | cuda | cpu
DEVICE=auto
PYTHON_BIN=python
INFERENCE_TIMEOUT_MS=300000
MAX_IMAGE_MB=15
