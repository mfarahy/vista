# Keep the Docker build context small: local Python venvs, checkpoints and
# OS artifacts never belong in the API image. NOTE: raster2seq/ (upstream)
# is intentionally INCLUDED — the GPU image (Dockerfile.gpu) needs it at
# runtime; it only adds ~21 MB to the mock image context.
.venv/
venv/
__pycache__/
*.pyc
checkpoints/
pred_outputs/
tmp/
*.pth
node_modules/
api/node_modules/
api/.env
.env
.git/
.DS_Store
