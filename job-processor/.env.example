# Log level: fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
# NATS connection URL. Must match the instance used by expose-service.
NATS_URL=nats://localhost:4222
# NATS subject prefix to consume; the consumer subscribes to `<prefix>.>`.
NATS_SUBJECT_PREFIX=vista.jobs
# NATS subject prefix for job progress events (`<prefix>.<jobId>`). Must match
# expose-service (default `vista.progress`).
NATS_PROGRESS_SUBJECT_PREFIX=vista.progress
# PostgreSQL connection used to persist job status and read/write the shared
# Document records. Shares the Job/Document tables with expose-service (which
# owns schema creation).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vista
PORT=4100
HOST=0.0.0.0

# Document file storage used by the document-processing pipeline. "local"
# (default) reads bytes from UPLOAD_DIR; "r2" reads them from Cloudflare R2
# (any S3-compatible bucket). expose-service writes the files here on upload;
# the worker reads them directly, without an HTTP hop.
DOCUMENT_STORAGE_PROVIDER=local
UPLOAD_DIR=../public/uploads
# Cloudflare R2 (S3-compatible) credentials.
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Document OCR / analysis provider.
DOCUMENT_ANALYSIS_PROVIDER=google
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Path to a service-account JSON file or inline JSON. Leave empty to use
# Application Default Credentials (gcloud auth application-default login).
GOOGLE_DOCUMENT_AI_CREDENTIALS=
# Document understanding (AI extraction) provider.
DOCUMENT_UNDERSTANDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# MeltFlex floor-plan-to-3D provider (server-side only).
MELTFLEX_API_KEY=
# Floorplan recognition Docker model endpoint (for floorplan-recognition provider).
FLOORPLAN_RECOGNITION_URL=http://localhost:5000/predictions
# Active 2D-to-3D provider: "floorplan-recognition" (default) or "meltflex".
FLOORPLAN_3D_PROVIDER=floorplan-recognition
# Public base URL of expose-service so MeltFlex can fetch floor plan images via signed/public URL.
PUBLIC_API_BASE_URL=http://localhost:4000
EXPOSE_SERVICE_URL=http://localhost:4000

# Output format: "text" (default, human-readable) or "json" (structured).
LOG_FORMAT=text