# Log level: fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
# NATS connection URL. Must match the instance used by expose-service.
NATS_URL=nats://localhost:4222
# NATS subject prefix to consume; the consumer subscribes to `<prefix>.>`.
NATS_SUBJECT_PREFIX=vista.jobs
# PostgreSQL connection used to persist job status. Shares the Job table
# with expose-service (which owns schema creation).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vista
PORT=4100
HOST=0.0.0.0
