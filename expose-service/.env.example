PORT=4000
HOST=0.0.0.0
# Structured logging level (fatal|error|warn|info|debug|trace|silent).
# Defaults: info in production, debug in development, silent in tests.
LOG_LEVEL=
# HTTP request header used to read/propagate the correlation id.
CORRELATION_ID_HEADER=x-correlation-id
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
# Base URL of the Next.js app that hosts the print route used by PDF export.
FRONTEND_URL=http://localhost:3000
DATA_DIR=./data
UPLOAD_DIR=./public/uploads
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional sampling temperature. Leave empty to use the model default. Models
# like gpt-5 only support the default, so do not set 0 here for those.
OPENAI_TEMPERATURE=
FAL_KEY=
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
GEOCODING_USER_AGENT=Vista/1.0
PLACES_PROVIDER=
PLACES_BASE_URL=
PLACES_USER_AGENT=Vista/1.0
# Routing for verified distances and travel times of nearby facilities.
# Set to "osrm" to enable the free OSRM endpoints (foot/bike/car; no public
# transport). When unset, facilities are collected but never presented with
# distances or travel times.
ROUTING_PROVIDER=
ROUTING_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot/route/v1
ROUTING_BIKE_BASE_URL=https://routing.openstreetmap.de/routed-bike/route/v1
ROUTING_CAR_BASE_URL=https://router.project-osrm.org/route/v1
LOCATION_SEARCH_RADIUS_METERS=1000
LOCATION_FACILITY_CATEGORIES=supermarket,kindergarten,school,train_station,bus_stop,pharmacy,park,restaurant,cafe
MAP_ATTRIBUTION=Vista
BORIS_BASE_URL=https://ogc-api.geobasis-bb.de/boris
DOCUMENT_ANALYSIS_PROVIDER=google
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Path to a service-account JSON file or inline JSON. Leave empty to use
# Application Default Credentials (gcloud auth application-default login).
GOOGLE_DOCUMENT_AI_CREDENTIALS=
DOCUMENT_UNDERSTANDING_PROVIDER=openai
# Maximum number of document analyses (OCR + AI) running in parallel per
# upload batch. Small values keep provider rate limits happy; default 3.
DOCUMENT_ANALYSIS_CONCURRENCY=3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vista
TAVILY_API_KEY="tvly-dev-XXXXXX"
