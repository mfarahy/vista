{
  "name": "vista-expose-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@mastra/core": "^1.60.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "playwright": "^1.55.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.5",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.44.0",
    "typescript": "^5.9.2"
  }
}
