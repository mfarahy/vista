{
  "name": "vista-expose-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "pw": "npx prettier --write ."
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@google-cloud/documentai": "^10.0.0",
    "@mastra/core": "^1.60.0",
    "@mastra/tavily": "1.1.1",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^7.5.0",
    "playwright": "^1.55.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.15.3",
    "eslint": "^10.5.0",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.44.0"
  }
