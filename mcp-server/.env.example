# Base URL of the running Vista agent-bridge HTTP server (see agent-bridge/).
# The MCP server is a thin adapter: every tool call is forwarded to this bridge.
AGENT_BRIDGE_URL=http://127.0.0.1:4200
# MCP server HTTP binding. Prefer a loopback address unless the server is
# exposed through a secure MCP tunnel.
MCP_HOST=127.0.0.1
MCP_PORT=4300
# Log level: fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
# Output format: "text" (default, human-readable) or "json" (structured).
LOG_FORMAT=text
