# URL of the running OpenCode server (`opencode serve`). The server must be
# started in the project directory the bridge should control.
OPENCODE_URL=http://127.0.0.1:4096
# Maximum time to wait for an OpenCode agent response to a prompt, in ms.
# Agent runs can take several minutes, so keep this generous.
OPENCODE_TIMEOUT_MS=600000
# Base URL of the running Vista frontend (`npm run dev` in frontend/, default
# http://localhost:3000). Used by POST /screenshot as default target and as
# prefix for relative page paths.
VISTA_APP_URL=http://localhost:3000
# Maximum time to wait for a page to load before capturing a screenshot, in ms.
SCREENSHOT_TIMEOUT_MS=60000
# Directory where captured screenshots are stored (relative to agent-bridge/).
SCREENSHOT_DIR=./data/screenshots
# Launch the screenshot browser headless ("true" or "false"). Headless
# Chromium is the default and requires no display.
SCREENSHOT_HEADLESS=true
# Bridge HTTP server.
PORT=4200
HOST=0.0.0.0
# Log level: fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
# Output format: "text" (default, human-readable) or "json" (structured).
LOG_FORMAT=text