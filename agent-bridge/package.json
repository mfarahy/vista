{
  "name": "vista-agent-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal local HTTP bridge that lets an external client drive an OpenCode session programmatically.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "pw": "npx prettier --write ."
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.23",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.3",
    "eslint": "^10.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.44.0"
  }
}
